#: main.cpp:50
msgid "KIO Exec - Opens remote files, watches modifications, asks for upload"
msgstr ""
"KIO Exec - Wočinja dataje na serweru, kedźbuje na změny, stara so wo "
"aktualizowanje"

#: main.cpp:54
msgid "Treat URLs as local files and delete them afterwards"
msgstr "URLe kaž lokalne dataje wobjednać a pozdźišo zničić"

#: main.cpp:55
msgid "Command to execute"
msgstr "Mjeno přikaza"

#: main.cpp:56
msgid "URL(s) or local file(s) used for 'command'"
msgstr "URL(e) abo lokalna dataja so za 'přikaz' wužiwa"

#: main.cpp:72
msgid ""
"'command' expected.\n"
msgstr ""
"'přikaz' wočakowany.\n"

#: main.cpp:97
msgid ""
"The URL %1\n"
"is malformed"
msgstr "URL '%1' je hubjenje formatowany."

#: main.cpp:99
msgid ""
"Remote URL %1\n"
"not allowed with --tempfiles switch"
msgstr ""
"Zdaleny URL %1\n"
"njehodźi so z parametrom --tempfiles wužiwać"

#: main.cpp:226
msgid ""
"The supposedly temporary file\n"
"%1\n"
"has been modified.\n"
"Do you still want to delete it?"
msgstr ""
"Pozdatnje temporarna dataja \"%1\" je so změniła.\n"
"Chceće ju přiwšěm zawěsćić?"

#: main.cpp:227 main.cpp:234
msgid "File Changed"
msgstr "Dataja změnjena."

#: main.cpp:227
#, fuzzy
msgid "Do Not Delete"
msgstr "Zničić"

#: main.cpp:233
msgid ""
"The file\n"
"%1\n"
"has been modified.\n"
"Do you want to upload the changes?"
msgstr ""
"Dataja \n"
"%1\n"
" je so změniła.\n"
"Chceće ju na serweru aktualizować?"

#: main.cpp:234
#, fuzzy
msgid "Upload"
msgstr "Kopěrjuju %1 na server"

