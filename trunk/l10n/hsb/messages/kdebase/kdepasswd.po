#: kdepasswd.cpp:24
msgid "Change password of this user"
msgstr "Tajne hesło tuteho wužiwarja změnić"

#: kdepasswd.cpp:31
msgid "KDE passwd"
msgstr "Tajne hesło za KDE"

#: kdepasswd.cpp:32
msgid "Changes a UNIX password."
msgstr "Tajne hesło za Unix změnić"

#: kdepasswd.cpp:34
msgid "Maintainer"
msgstr "Hladaćel"

#: kdepasswd.cpp:60
msgid "You need to be root to change the password of other users."
msgstr "Jenož 'root' móže tajne hesła tamnych wužiwarjow změnić."

#: passwddlg.cpp:19 passwddlg.cpp:87
msgid "Change Password"
msgstr "Tajne hesło změnić"

#: passwddlg.cpp:20
msgid "Please enter your current password:"
msgstr "Zapodajće prošu Waše tučasne tajne hesło:"

#: passwddlg.cpp:41 passwddlg.cpp:159
msgid "Conversation with 'passwd' failed."
msgstr "Wuměna z \"passwd\" je zwrěšćiła."

#: passwddlg.cpp:51
msgid "Could not find the program 'passwd'."
msgstr "Njejsym program \"passwd\" móhł namakać."

#: passwddlg.cpp:56
msgid "Incorrect password. Please try again."
msgstr "Wopačne tajne hesło. Prošu spytajće hišće raz."

#: passwddlg.cpp:60
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr ""

#: passwddlg.cpp:89
msgid "Please enter your new password:"
msgstr "Prošu zapodajće Waše nowe tajne hesło:"

#: passwddlg.cpp:91
msgid "Please enter the new password for user <b>%1</b>:"
msgstr "Prošu zapodajće nowe tajne hesło za <b>%1</b> :"

#: passwddlg.cpp:108
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it is."
msgstr ""
"Waše tajne hesło ma wjac hač 8 znamješkow. Někotre systemy móhli z tym ćeže "
"měć."

#: passwddlg.cpp:111
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it is."
msgstr ""
"Waše tajne hesło ma wjac hač 8 znamješkow. Někotre systemy móhli z tym ćeže "
"měć."

#: passwddlg.cpp:115
msgid "Password too long"
msgstr "Waše tajne hesło je předołhe."

#: passwddlg.cpp:116
msgid "Truncate"
msgstr "Wottřihać"

#: passwddlg.cpp:117
msgid "Use as is"
msgstr "Wužiwać kaž je"

#: passwddlg.cpp:138
msgid "Your password has been changed."
msgstr "Waše tajne hesło je so změniło."

#: passwddlg.cpp:148
msgid "Your password has not been changed."
msgstr "Waše tajne hesło njeje so změniło."

