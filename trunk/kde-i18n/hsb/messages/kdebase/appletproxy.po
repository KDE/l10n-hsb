#: appletproxy.cpp:65
msgid "The applet's desktop file"
msgstr "Powjerchowa dataja za miniprogramy"

#: appletproxy.cpp:66
msgid "The config file to be used"
msgstr "Konfiguraciska dataja, kiž ma so wužiwać"

#: appletproxy.cpp:67
msgid "DCOP callback id of the applet container"
msgstr "DCOP-Callback-ID containera miniprograma"

#: appletproxy.cpp:73 appletproxy.cpp:75
msgid "Panel applet proxy."
msgstr "Mjezyskład za miniprogramy."

#: appletproxy.cpp:97
msgid "No desktop file specified"
msgstr "Žana .desktop-dataja podata."

#: appletproxy.cpp:132
msgid "The applet proxy could not be started due to DCOP communication problems."
msgstr "Njemóžach proxy za miniprogramy startować problemow z DCOP-komunikaciju dla."

#: appletproxy.cpp:133 appletproxy.cpp:141 appletproxy.cpp:174
#: appletproxy.cpp:195 appletproxy.cpp:297 appletproxy.cpp:319
msgid "Applet Loading Error"
msgstr "Zmylk začitanja miniprograma"

#: appletproxy.cpp:140
msgid "The applet proxy could not be started due to DCOP registration problems."
msgstr "Njemóžach proxy za miniprogramy startować problemow z DCOP-registraciju dla."

#: appletproxy.cpp:173
#, c-format
msgid "The applet proxy could not load the applet information from %1."
msgstr "Proxy za miniprogramy njemóže informaciju wo miniprogramje z %1 začitać."

#: appletproxy.cpp:194
msgid "The applet %1 could not be loaded via the applet proxy."
msgstr "Miniprogram %1 njehodźi so přez proxy začitać."

#: appletproxy.cpp:296
msgid ""
"The applet proxy could not dock into the panel due to DCOP communication "
"problems."
msgstr "Njemóžach proxy do pasa integrować problemow z DCOP-komunikaciju dla."

#: appletproxy.cpp:318
msgid "The applet proxy could not dock into the panel."
msgstr "Miniprogram njehodźi so do pasa integrować."

