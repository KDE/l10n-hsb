#: runapplet.cpp:59
msgid "Run command:"
msgstr "Přikaz wuwjesć:"

#: runapplet.cpp:179
msgid "< Run"
msgstr "< wuwjesć"

#: runapplet.cpp:186
msgid "Run >"
msgstr "wuwjesć >"

#: runapplet.cpp:234
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr "Dyrbiće najprjedy přikaz zapodać, kiž ma so wuwjesć, abo URL, kiž ma so wočinić."

#: runapplet.cpp:245
msgid ""
"Unable to logout properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"Njemóžu Was porjadnje wotzjewić.\n"
"Rjadowar posedźenja njereaguje. Móžeće tuchwilne posedźenje z"
"Strg Alt Backspace skónčić. Tuchwilne posedźenje so pak njewobchowa."

#: runapplet.cpp:276
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>Program abo přikaz <b>%1</b>\n"
"njehodźi so namakać. Prošu zapodajće korektny přikaz \n"
"abo URL a spytajće hišće raz</qt>"

#: runapplet.cpp:288
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>Njemóžach <b>%1</b> startować.\n"
"Prošu zapodajće korektny přikaz abo URL a spytajće hišće raz.</qt>"

