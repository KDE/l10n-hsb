#: fileshare.cpp:39
msgid "File Sharing"
msgstr "Zhromadne wužiwanje datajow"

#: fileshare.cpp:43
msgid "Do &not allow users to share files"
msgstr "Zhromadne wužiwanje datajow &njedowolić"

#: fileshare.cpp:44
msgid "&Allow users to share files from their HOME folder"
msgstr "&Wužiwarjam dowolić, dataje z jich domjaceho zapiska wužiwać."

#: fileshare.cpp:55
msgid ""
"SMB and NFS servers are not installed on this machine, to enable this module "
"the servers must be installed."
msgstr "SMB a NFS njejstej na tutym kompjuterje instalowanej. Za wužiwanje tutoho modula dyrbitej so instalować."

#: fileshare.cpp:140
msgid ""
"<h1>File Sharing</h1><p>This module can be used to enable file sharing over "
"the network using the \"Network File System\" (NFS) or SMB in Konqueror. The "
"latter enables you to share your files with Windows(TM) computers on your "
"network.</p>"
msgstr ""
"<h1>Zhromadne wužiwanje datajow</h1> "
"<p>Tutón modul so wužiwa za zhromadne wužiwanje datajow přez NFS (Network File System) abo SMB w konquerorje. SMB zmóžni zhromadne wužiwanje datajow z Windows (c)-ličakami we Wašej syći.</p>"

