#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Edward Wornar"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "e.werner@rz.uni-leipzig.de"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Spušćomny manager posedźenja KDE, kiž rozumi standardowy X11R6-protokol\n"
"za rjadowanje posedźenja (XSMP)."

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr "Wobnowi zawěsćene posedźenje wužiwarja, je-li tajke eksistuje."

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Startuje 'wm', jeli žadyn druhi woknowy manager njeběži.\n"
"Standard je 'kwin'."

#: main.cpp:38
msgid "Also allow remote connections."
msgstr "Dowoli tež zwiski z druhich ličakow."

#: main.cpp:176
msgid "The KDE Session Manager"
msgstr "KDE rjadowar posedźenja"

#: shutdown.cpp:82
msgid "End Session for \"%1\""
msgstr "Posedźenje za \"%1\" zakónčić"

#: shutdown.cpp:106
msgid "What do you want to do next?"
msgstr "Što chceće jako přichodne činić?"

#: shutdown.cpp:107
msgid "&Login as different user"
msgstr "so jako &druhi wužiwar přizjewić"

#: shutdown.cpp:108
msgid "&Turn off computer"
msgstr "computer &hasnyć"

#: shutdown.cpp:109
msgid "&Restart computer"
msgstr "computer znowa &startować"

#: shutdown.cpp:130
msgid "Shutdown Mode"
msgstr "Wašnje hasnjenja"

#: shutdown.cpp:131
msgid "Sch&edule"
msgstr "&Planowane"

#: shutdown.cpp:133
msgid "&Force now"
msgstr "&Nětko přetłóčić"

#: shutdown.cpp:134
msgid "&Try now"
msgstr "Nětko &spytać"

#: shutdown.cpp:145
msgid "&Logout"
msgstr "&Wotzjewić"

