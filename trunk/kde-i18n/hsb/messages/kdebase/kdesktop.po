#: lock/lockdlg.cc:75
msgid "<nobr><b>The screen is locked</b><br>"
msgstr "<nobr><b>Wobrazowka je zamknjena</b><br>"

#: lock/lockdlg.cc:76
msgid "<nobr><b>The screen is locked by %1</b><br>"
msgstr "<nobr><b>Wobrazowka bu zamknjena wot %1</b><br>"

#: krootwm.cc:745 lock/lockdlg.cc:86 lock/lockdlg.cc:526
msgid "&Start New Session"
msgstr "&Nowu sesiju započeć"

#: lock/lockdlg.cc:187
msgid "<b>Unlocking failed</b>"
msgstr "<b>Zběhnjenje blokowanja so njeje poradźiło</b>"

#: lock/lockdlg.cc:193
msgid "<b>Warning: Caps Lock on</b>"
msgstr "<b>Kedźbu: Stajne wulkopisanje zaswěćene</b>"

#: lock/lockdlg.cc:417
msgid ""
"Cannot unlock the screen, as the authentication system fails to work.\n"
"You must kill kdesktop_lock (pid %1) manually."
msgstr ""
"Njemóžu wobrazowku wotamkać, dokelž přizjewjenski system njefunguje\n"
"Dyrbiće manualnje kdeskto_lock (pid %1) wottřělić."

#: lock/lockdlg.cc:515
msgid ""
"You have chosen to open another desktop session instead of resuming the "
"current one.<br>The current session will be hidden and a new login screen "
"will be displayed.<br>An F-key is assigned to each session; F%1 is usually "
"assigned to the first session, F%2 to the second session and so on. You can "
"switch between sessions by pressing CTRL, ALT and the appropriate F-key at "
"the same time."
msgstr ""

#: lock/lockprocess.cc:659
msgid "Will not lock the screen, as unlocking would be impossible:\n"
msgstr "Njezamknu wobrazowku, dokelž njebudźe móžno ju wotamknyć:\n"

#: lock/lockprocess.cc:663
msgid "Cannot start <i>kcheckpass</i>."
msgstr "Njemóžu <i>kcheckpass</i> startować."

#: lock/lockprocess.cc:664
msgid "<i>kcheckpass</i> is unable to operate. Possibly it is not SetUID root."
msgstr "<i>kcheckpass</i> njefunguje. Najskerje njeje SetUID root."

#: lock/lockprocess.cc:708
msgid "No appropriate greeter plugin configured."
msgstr "Žadyn kmany powitanski plugin nastajeny."

