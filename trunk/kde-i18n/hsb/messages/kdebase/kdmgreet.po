#: kgreeter.cpp:632
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile for more information\n"
"or contact your system administrator."
msgstr ""
"Kritiski zmylk je so stał\n"
"Prošu pohladaj do protokoloweje dataje KDMa dla "
"dalšeje informacije abo skontaktuj so ze swojim "
"administratorom."

#: kgreeter.cpp:637
msgid "Home directory not available."
msgstr "Domjacy zapisk njeeksistuje."

#: kgreeter.cpp:640
msgid "Root logins are not allowed."
msgstr "Root so tu njesmě přizjewić."

#: kgreeter.cpp:644
msgid "Your login shell is not listed in /etc/shells."
msgstr "Waš přizjewjenski přikazowy program njeje w /etc/shells."

#: kgreeter.cpp:647
msgid "Your account has expired."
msgstr "Waše konto hižo njepłaći."

#: kgreeter.cpp:650
msgid "Your password has expired."
msgstr "Waše hesło hižo njepłaći."

#: kgreeter.cpp:653
msgid ""
"You are not allowed to login\n"
"at the moment."
msgstr "Njesměće so tuchwilu přizjewić."

#: kgreeter.cpp:670
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"Přizjewjenja tuchwilu njejsu dowolene.\n"
"Spytajće hišće raz pozdźišo."

#: kgreeter.cpp:705
msgid "Your account expires today."
msgstr "Waše konto budźe dźensa njepłaćiwe."

#: kgreeter.cpp:708
#, c-format
msgid ""
"_n: Your account expires tomorrow.\n"
"Your account expires in %n days."
msgstr ""
"Waše konto budźe jutře njepłaćiwe.\n"
"Waše konto budźe za %n dnjej njepłaćiwe.\n"
"Waše konto budźe za %n dny njepłaćiwe.\n"
"Waše konto budźe za %n dnjow njepłaćiwe."

#: kgreeter.cpp:713
msgid "Your password expires today."
msgstr "Waše hesło budźe dźensa njepłaćiwe."

#: kgreeter.cpp:716
#, c-format
msgid ""
"_n: Your password expires tomorrow.\n"
"Your password expires in %n days."
msgstr ""
"Waše hesło budźe jutře njepłaćiwe.\n"
"Waše hesło budźe za %n dnjej njepłaćiwe.\n"
"Waše hesło budźe za %n dny njepłaćiwe.\n"
"Waše hesło budźe za %n dnjow njepłaćiwe."

