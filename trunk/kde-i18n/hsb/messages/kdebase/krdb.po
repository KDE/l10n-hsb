#: krdb.cpp:325
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the "
"checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# stworjene přez KDE, %1\n"
"#\n"
"# jeli nochceće, zo KDE waše GTK-opcije ignoruje, wubjerće\n"
"# Napohlady & Temy -> Barby w Kontrolnym Centrumje a njewubjerće\n"
"# \"Wužiwaj barby za programy, njespisane za KDE\"\n"
"#\n"
"#\n"
