#: kdepasswd.cpp:25
msgid "Change password of this user."
msgstr "Hesło tutoho wužiwarja změnić."

#: kdepasswd.cpp:32
msgid "KDE passwd"
msgstr "KDE hesłar"

#: kdepasswd.cpp:33
msgid "Changes a UNIX password."
msgstr "Změni UNIX-hesło."

#: kdepasswd.cpp:35
msgid "Maintainer"
msgstr "Maintainer"

#: kdepasswd.cpp:51
msgid "You need to be root to change the password of other users."
msgstr "Dyrbiš być root, zo by hesło druhich wužiwarjow změnił."

#: passwddlg.cpp:19 passwddlg.cpp:87
msgid "Change Password"
msgstr "Hesło změnić"

#: passwddlg.cpp:20
msgid "Please enter your current password."
msgstr "Prošu zapodajće swoje nětčiše hesło."

#: passwddlg.cpp:41 passwddlg.cpp:159
msgid "Conversation with `passwd' failed."
msgstr "Komunikacija z 'passwd' njeje fungowała."

#: passwddlg.cpp:51
msgid "Could not find the program `passwd'."
msgstr "Njemóžach program 'passwd' namakać."

#: passwddlg.cpp:56
msgid "Incorrect password! Please try again."
msgstr "Njekorektne hesło! Prošu spytajće hišće raz."

#: passwddlg.cpp:60
msgid "Internal error: illegal return value from PasswdProcess::checkCurrent."
msgstr "Nutřkowny zmylk: njelegalna hódnota z PasswdProcess::checkCurrent."

#: passwddlg.cpp:89
msgid "Please enter your new password."
msgstr "Prošu zapodajće swoje nowe hesło."

#: passwddlg.cpp:91
msgid "Please enter the new password for user <b>%1</b>."
msgstr "Prošu zapodajće nowe hesło za wužiwarja <b>%1</b>."

#: passwddlg.cpp:108
msgid ""
"Your password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Waše hesło je dlěše hač wosom pismikow. Na někotrych systemach móže "
"to ćeže zawinić. Móžeće swoje hesło na wosom pismikow skrótšić abo "
"je tajke wostajić."

#: passwddlg.cpp:111
msgid ""
"The password is longer than 8 characters. On some systems, this can cause "
"problems. You can truncate the password to 8 characters, or leave it as it "
"is."
msgstr ""
"Hesło je dlěše hač wosom pismikow. Na někotrych systemach móže to "
"ćeže zawinić. Móžeće hesło na wosom pismikow skrótšić abo je tajke "
"wostajić."

#: passwddlg.cpp:115
msgid "Password too long"
msgstr "Předołhe hesło"

#: passwddlg.cpp:116
msgid "Truncate"
msgstr "Skrótšić"

#: passwddlg.cpp:117
msgid "Use as is"
msgstr "Wužiwać, kajkež je"

#: passwddlg.cpp:138
msgid "Your password has been changed."
msgstr "Waše hesło bu změnjene."

#: passwddlg.cpp:148
#, fuzzy
msgid "Your password has not been changed."
msgstr "Waše hesło bu změnjene."

#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "Edward Wornar"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "e.werner@rz.uni-leipzig.de"

