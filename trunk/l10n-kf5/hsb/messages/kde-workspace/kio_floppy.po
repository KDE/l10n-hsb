#: kio_floppy.cpp:199
#, kde-format
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"Nimam přistup na disketnik %1.\n"
"Disketnik hišće dźěła.\n"
"Dočakajće, doniž njeje njeaktiwny a spytajće hišće raz."

#: kio_floppy.cpp:203 kio_floppy.cpp:1117
#, kde-format
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"Njemóžach do dataje %1 pisać.\n"
"Disketa w disketniku %2 je najskerje połny."

#: kio_floppy.cpp:213
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"Nimam přistup na %1.\n"
"Najskerje njeje žana disketa w disketniku %2"

#: kio_floppy.cpp:217
#, kde-format
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough "
"permissions to access the drive."
msgstr ""
"Nimam přistup na %1.\n"
"Najskerje njeje žana disketa w disketniku %2 abo nimaće dosće přistupnych "
"prawow."

#: kio_floppy.cpp:221
#, kde-format
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"Nimam přistup na %1.\n"
"Disketnik %2 njeje podpěrany."

#: kio_floppy.cpp:226
#, kde-format
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set "
"correctly (e.g. rwxrwxrwx)."
msgstr ""
"Nimam přistup na %1.\n"
"Přepruwujće, hač je disketa w disketniku %2 DOS-disketa\n"
"a hač su přistupne prawa gratoweje dataje (na př. /dev/fd0) korektne (na př. "
"rwxrwxrwx)."

#: kio_floppy.cpp:230
#, kde-format
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"Nimam přistup na %1.\n"
"Disketa w disketniku %2 najskerje njeje DOS-disketa."

#: kio_floppy.cpp:234
#, kde-format
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"Nimam přistup.\n"
"Njemóžach pisać do %1.\n"
"Disketa w disketniku %2 je najskerje škitana. "

#: kio_floppy.cpp:243
#, kde-format
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"Njemóžach bootsektor w %1 čitać.\n"
"Najskerje njeje žana disketa w disketniku %2."

#: kio_floppy.cpp:366
#, kde-format
msgid ""
"Could not start program \"%1\".\n"
"Ensure that the mtools package is installed correctly on your system."
msgstr ""
"Njemóžach program \"%1\" startować.\n"
"Přepruwujće, hač je pakćik mtools korektnje instalowany."
