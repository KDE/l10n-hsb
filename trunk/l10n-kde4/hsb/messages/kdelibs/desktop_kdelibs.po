msgctxt "Name"
msgid "Python encoding checker/adder"
msgstr "Python encoding checker/adder"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:29
msgctxt "Comment"
msgid "While saving check encoding of python files and add an encoding line"
msgstr ""
"Přepruwuje koděrowanje python-datajow a doda linku z informaciju wo "
"koděrowanju"

