#: fileprops.cpp:230
#, kde-format
msgid "kfile"
msgstr "kfile"

#: fileprops.cpp:231
#, kde-format
msgid "A command-line tool to read and modify metadata of files."
msgstr ""

#: fileprops.cpp:232
#, kde-format
msgid "(c) 2002, Carsten Pfeiffer"
msgstr ""

#: fileprops.cpp:236
#, kde-format
msgid "Carsten Pfeiffer"
msgstr ""

#: fileprops.cpp:245
#, kde-format
msgid "Do not print the mimetype of the given file(s)"
msgstr "MIME-typ datych datajow njewućišćeć "

#: fileprops.cpp:247
#, kde-format
msgid "List all supported metadata keys."
msgstr ""

#: fileprops.cpp:249
#, kde-format
msgid "List all metadata keys which have a value in the given file(s)."
msgstr ""
"Naličuje wšitke metadatowe kluče, kiž su we wubranych datajach definowane."

#: fileprops.cpp:252
#, kde-format
msgid ""
"Do not print a warning when more than one file was given and they do not all "
"have the same mimetype."
msgstr ""
"Njehórš so, jeli so dwě abo wjace datajow podawa, kiž nimaja wšě samsnu mime-"
"družinu."

#: fileprops.cpp:255
#, kde-format
msgid "Prints all metadata values, available in the given file(s)."
msgstr ""
"Pokazuje wšitke metadatowe hódnoty, kiž steja we wubranych datajach k "
"dispoziciji."

#: fileprops.cpp:257
#, kde-format
msgid ""
"Opens a KDE properties dialog to allow viewing and modifying of metadata of "
"the given file(s)"
msgstr ""
"Wočini dialog KDE-swójstwow za pokazowanje a modifikowanje metadatow "
"wubranych datajow."

#: fileprops.cpp:259
#, kde-format
msgid ""
"Prints the value for 'key' of the given file(s). 'key' may also be a comma-"
"separated list of keys"
msgstr ""
"Pokazuje hódnotu za 'kluč' wubranych datajow. 'kluč' móže tež być lisćina "
"klučow, wotdźělenych přez komy."

#: fileprops.cpp:261
#, kde-format
msgid ""
"Attempts to set the value 'value' for the metadata key 'key' for the given "
"file(s)"
msgstr ""
"Spyta hódnotu metadatoweho kluča 'kluč' wubranych datajow na 'hódnotu' "
"sadźić.."

#: fileprops.cpp:263
#, kde-format
msgid "The file (or a number of files) to operate on."
msgstr "Dataja (abo mnóstwo datajow), na kotrež ma so akcija wuskutkować."

#: fileprops.cpp:277
#, kde-format
msgid "No files specified"
msgstr "Žane dataje wubrane"

#: fileprops.cpp:297
#, kde-format
msgid "Cannot determine metadata"
msgstr "Njemóžu metadaty zwěsćić"
