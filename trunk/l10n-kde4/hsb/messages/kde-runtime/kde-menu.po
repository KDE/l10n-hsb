#: kde-menu.cpp:93
#, kde-format
msgid "Menu item '%1' could not be highlighted."
msgstr "Menijowy zapis '%1' njehodźeše so wuzběhnyć."

#: kde-menu.cpp:106
#, kde-format
msgid ""
"KDE Menu query tool.\n"
"This tool can be used to find in which menu a specific application is "
"shown.\n"
"The --highlight option can be used to visually indicate to the user where\n"
"in the KDE menu a specific application is located."
msgstr ""

#: kde-menu.cpp:111
#, kde-format
msgid "kde-menu"
msgstr "kde-menu"

#: kde-menu.cpp:113
#, kde-format
msgid "(c) 2003 Waldo Bastian"
msgstr "(c) 2003 Waldo Bastian"

#: kde-menu.cpp:114
#, kde-format
msgid "Waldo Bastian"
msgstr "Waldo Bastian"

#: kde-menu.cpp:114
#, kde-format
msgid "Author"
msgstr "Awtor"

#: kde-menu.cpp:119
#, kde-format
msgid "Output data in UTF-8 instead of local encoding"
msgstr "Pisam daty w UTF-8 město lokalneho kodowanja"

#: kde-menu.cpp:120
#, kde-format
msgid ""
"Print menu-id of the menu that contains\n"
"the application"
msgstr ""
"Pokaž menijowy id menija,\n"
"w kotrymž so namaka aplikacija"

#: kde-menu.cpp:121
#, kde-format
msgid ""
"Print menu name (caption) of the menu that\n"
"contains the application"
msgstr ""
"Pokazuje menijowe napismo menija,\n"
"w kotrymž je aplikacija"

#: kde-menu.cpp:122
#, kde-format
msgid "Highlight the entry in the menu"
msgstr "Wuzběhuje zapis w meniju"

#: kde-menu.cpp:123
#, kde-format
msgid "Do not check if sycoca database is up to date"
msgstr "Nic přepruwować, hač je datowa banka sycoca aktualizowana"

#: kde-menu.cpp:124
#, kde-format
msgid "The id of the menu entry to locate"
msgstr "id menijoweho zapisa, kiž ma so namakać"

#: kde-menu.cpp:133
#, kde-format
msgid "You must specify an application-id such as 'kde4-konsole.desktop'"
msgstr "Dyrbiće id aplikacije podać, na př. 'kde4-konsole.desktop'"

#: kde-menu.cpp:142
#, kde-format
msgid ""
"You must specify at least one of --print-menu-id, --print-menu-name or --"
"highlight"
msgstr ""
"Dyrbiće znajmjeńša jedne z --print-menu-id, --print-menu-name abo --"
"highlight podać"

#: kde-menu.cpp:164
#, kde-format
msgid "No menu item '%1'."
msgstr "Žadyn menijowy zapis '%1'."

#: kde-menu.cpp:168
#, kde-format
msgid "Menu item '%1' not found in menu."
msgstr "Njejsym zapis '%1' w meniju namakał."
