#: kcmxinerama.cpp:55
msgid "kcmxinerama"
msgstr "kcmxinerama"

#: kcmxinerama.cpp:56
msgid "KDE Multiple Monitor Configurator"
msgstr "KDE-konfigurator za wjacore wobrazowki"

#: kcmxinerama.cpp:58
msgid "(c) 2002-2003 George Staikos"
msgstr "(c) 2002-2003 George Staikos"

#: kcmxinerama.cpp:60
msgid "George Staikos"
msgstr "George Staikos"

#: kcmxinerama.cpp:63
msgid ""
"<h1>Multiple Monitors</h1> This module allows you to configure KDE support "
"for multiple monitors."
msgstr ""
"<h1>Wjacore wobrazowki</h1>Tutón modul dowoli Wam KDE za wjacore wobrazowki "
"připrawić."

#: kcmxinerama.cpp:87
#, kde-format
msgid "Display %1"
msgstr "Wobrazowka %1"

#: kcmxinerama.cpp:105
msgid "Display Containing the Pointer"
msgstr "Wobrazowka z myšacym pokazowakom"

#: kcmxinerama.cpp:116
msgid ""
"<qt><p>This module is only for configuring systems with a single desktop "
"spread across multiple monitors. You do not appear to have this "
"configuration.</p></qt>"
msgstr ""
"<qt><p>Tutón modul je jenož za připrawjenje systemow z dźěłowym powjerchom, "
"kotryž so rozpřestrěwa přez wjacore wobrazowki. Waš system to njepotrjechi, "
"kaž so zda.</p></qt>"

#: kcmxinerama.cpp:180
msgid "Some settings may affect only newly started applications."
msgstr "Někotre nastajenja wuskutkuja so jenož na znowa startowane programy."

#: kcmxinerama.cpp:180
msgid "KDE Multiple Monitors"
msgstr "KDE z wjacorymi wobrazowkami"

#. i18n: file: xineramawidget.ui:17
#. i18n: ectx: property (title), widget (QGroupBox, ButtonGroup1)
#: rc.cpp:3 rc.cpp:47
msgid "Multiple Monitor Support"
msgstr "Podpěra za wjacore wobrazowki"

#. i18n: file: xineramawidget.ui:23
#. i18n: ectx: property (text), widget (QCheckBox, _enableXinerama)
#: rc.cpp:6 rc.cpp:50
msgid "Enable multiple monitor virtual desktop support"
msgstr "Podpěru za wirtuelne powjerchi přez wjacore wobrazowki zaswěćić"

#. i18n: file: xineramawidget.ui:33
#. i18n: ectx: property (text), widget (QCheckBox, _enableResistance)
#: rc.cpp:9 rc.cpp:53
msgid "Enable multiple monitor window resistance support"
msgstr "Podpěru za woknowy zapěr přez wjacore wobrazowki zaswěćić"

#. i18n: file: xineramawidget.ui:43
#. i18n: ectx: property (text), widget (QCheckBox, _enablePlacement)
#: rc.cpp:12 rc.cpp:56
msgid "Enable multiple monitor window placement support"
msgstr "Podpěru za pozicioněrowanje woknow přez wjacore wobrazowki zaswěćić"

#. i18n: file: xineramawidget.ui:53
#. i18n: ectx: property (text), widget (QCheckBox, _enableMaximize)
#: rc.cpp:15 rc.cpp:59
msgid "Enable multiple monitor window maximize support"
msgstr "Podpěru za maksimalizowanje woknow přez wjacore wobrazowki zaswěćić"

#. i18n: file: xineramawidget.ui:63
#. i18n: ectx: property (text), widget (QCheckBox, _enableFullscreen)
#: rc.cpp:18 rc.cpp:62
msgid "Enable multiple monitor window fullscreen support"
msgstr "Podpěru za cyłowobrazowkowe programy přez wjacore wobrazowki zaswěćić"

