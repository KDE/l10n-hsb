#~ msgid ""
#~ "<qt><p>This module is only for configuring systems with a single desktop "
#~ "spread across multiple monitors. You do not appear to have this "
#~ "configuration.</p></qt>"
#~ msgstr ""
#~ "<qt><p>Tutón modul je jenož za připrawjenje systemow z dźěłowym "
#~ "powjerchom, kotryž so rozpřestrěwa přez wjacore wobrazowki. Waš system to "
#~ "njepotrjechi, kaž so zda.</p></qt>"
