#: main.cpp:31
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"Spušćomny manager posedźenja KDE, kiž rozumi standardowy X11R6-protokol\n"
"za rjadowanje posedźenja (XSMP)."

#: main.cpp:36
msgid "Restores the saved user session if available"
msgstr "Wobnowi zawěsćene posedźenje wužiwarja, je-li tajke eksistuje."

#: main.cpp:38
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Startuje 'wm', jeli žadyn druhi woknowy manager njeběži.\n"
"Standard je 'kwin'."

#: main.cpp:39
#, fuzzy
msgid "Also allow remote connections"
msgstr "Dowoli tež zwiski z druhich ličakow."

