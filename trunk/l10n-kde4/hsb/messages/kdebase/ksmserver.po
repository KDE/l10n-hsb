#: main.cpp:210
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"Startuje 'wm', jeli žadyn druhi woknowy manager njeběži.\n"
"Standard je 'kwin'."

