msgid "Unsaved Changes"
msgstr "Njeskładowane změny"

#: helpwidget.cpp:63
#, fuzzy, kde-format
msgid ""
"<p>Use the \"Whats This\" (Shift+F1) to get help on specific options.</"
"p><p>To read the full manual click <a href=\"%1\">here</a>.</p>"
msgstr ""
"<p>Wužiwajće \"Što je to? \" (Shift+F1), jeli trjebaće pomoc za jednotliwe "
"opcije.</p><p>Jeli chceće cyłu přiručku čitać, stłóčće <a href=\"%1\">tu</a>."
"</p>"

#: helpwidget.cpp:70
#, fuzzy
#| msgid ""
#| "<h1>KDE Info Center</h1>There is no quick help available for the active "
