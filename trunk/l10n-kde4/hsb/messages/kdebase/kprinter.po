#: main.cpp:29
msgid "Make an internal copy of the files to print"
msgstr "Internu kopiju datajow stworić, kiž maja so ćišćeć"

#: main.cpp:31
msgid "Printer/destination to print on"
msgstr "Ćišćak/cil na kotryž ma so ćišćeć"

#: main.cpp:33
msgid "Title/Name for the print job"
msgstr "Titl/Mjeno ćišćenskeho nadawka"

#: main.cpp:35
msgid "Number of copies"
