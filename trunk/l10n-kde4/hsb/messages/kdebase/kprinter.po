#: main.cpp:36
msgid "Printer option"
msgstr "Opcije za ćišćak"

#: main.cpp:37
msgid "Job output mode (gui, console, none)"
msgstr "Modus outputa (gui, terminal, žadyn)"

#: main.cpp:38
msgid "Print system to use (lpd, cups)"
msgstr "Ćišćenski system (lpd, cups)"

#: main.cpp:39
msgid "Allow printing from STDIN"
msgstr "Ćišćenje wot STDIN dowolić"

#: main.cpp:40
#, fuzzy
msgid "Do not show the print dialog (print directly)"
msgstr "Njepokaž ćišćenski dialog (hnydom ćišćeć)"

#: main.cpp:41
msgid "Files to load"
msgstr "Dataje za začitanje"

#: main.cpp:47
#, fuzzy
msgid "KPrinter"
msgstr "Ćišćenski zmylk"

#: main.cpp:47
msgid "A printer tool for KDE"
msgstr "Ćišćenski pomocnik za KDE"

#: printwrapper.cpp:64
msgid "Print Information"
msgstr "Informacija wo ćišćenju"

#: printwrapper.cpp:65
