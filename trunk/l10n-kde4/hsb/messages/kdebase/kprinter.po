msgstr "Ćišćenske warnowanje"

#: printwrapper.cpp:72
msgid "Print error"
msgstr "Ćišćenski zmylk"

#: printwrapper.cpp:188
msgid ""
"A file has been specified on the command line. Printing from STDIN will be "
"disabled."
msgstr ""
"Na komandowej lince bu dataja specifikowana. Ćišćenje ze STDIN so znjemóžni."

#: printwrapper.cpp:194
msgid ""
"When using '--nodialog', you must at least specify one file to print or use "
"the '--stdin' flag."
msgstr ""
"Hdyž so wužiwa '--nodialog', dyrbiće znajmjeńša jednu dataju za ćišćenje "
"zapodać abo '--stdin' wužiwać."

#: printwrapper.cpp:243
msgid "The specified printer or the default printer could not be found."
msgstr "Njemóžach pominany ćišćak abo standardny ćišćak namakać."

#: printwrapper.cpp:245
msgid "Operation aborted."
msgstr "Akcija přetorhnjena."

#: printwrapper.cpp:275
msgid "Unable to construct the print dialog."
msgstr "Njemóžach ćišćenski dialog nastajić."

#: printwrapper.cpp:316
#, qt-format
msgid "Multiple files (%1)"
msgstr "Wjacore dataje (%1)"

#: printwrapper.cpp:323
msgid "Nothing to print."
msgstr ""

#: printwrapper.cpp:348
msgid "Unable to open temporary file."
msgstr "Njemóžach temporarnu dataju wočinić."

#: printwrapper.cpp:363
msgid "Stdin is empty, no job sent."
msgstr "STDIN je prózdny, žadyn ćišćenski nadawk."

