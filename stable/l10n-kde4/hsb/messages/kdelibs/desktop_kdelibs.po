#: interfaces/kimproxy/interface/dbusinstantmessenger.desktop:4
msgctxt "Comment"
msgid "Instant Messenger with a D-Bus interface"
msgstr "Instant Messenger z DCOP-interfejsom"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:1
msgctxt "Name"
msgid "Instant Messenger"
msgstr "Instant Messenger"

#: interfaces/kimproxy/interface/kcm_instantmessenger.desktop:75
msgctxt "Comment"
msgid ""
"The instant messenger allows two-way chat between individuals and groups."
msgstr ""
"Instant messenger zmóžni jednotliwcam a skupinam spěšnu wuměnu zdźělenkow."

#: interfaces/kspeech/dbustexttospeech.desktop:4
msgctxt "Comment"
msgid "Text-to-Speech Service with a D-Bus interface"
msgstr "konwertowanje teksta na rěč z D-Bus-interfejsom"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:1
msgctxt "Name"
msgid "Embedded Text Editor"
msgstr "Integrowane wobdźěłanje tekstow"

#: interfaces/ktexteditor/kcm_ktexteditor.desktop:84
msgctxt "Comment"
msgid ""
"The text editor service provides applications with a text viewer and editor. "
"KDE applications that provide text editing facilities should use this "
"service."
msgstr ""
"Wobdźěłanje teksta staji programam wobdźěłarja a wobhladowarja teksta k "
"dispoziciji. KDE-aplikacije, kiž tajke něšto trjebaja, měli tutón serwis "
"wužiwać."

#: interfaces/ktexteditor/ktexteditor.desktop:5
msgctxt "Comment"
msgid "Embeddable Text Editor Component (with Doc/View Separation)"
msgstr "Komponenta za integrowane wobdźěłanje teksta"

#: interfaces/ktexteditor/ktexteditor_loadsavefiltercheckplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor load/save filter/check plugin"
msgstr "KTextEditor plugin za wočinjenje/zawěsćenje"

#: interfaces/ktexteditor/ktexteditorplugin.desktop:5
msgctxt "Comment"
msgid "KTextEditor Plugin"
msgstr "KTextEditor zašćěpka"

#: kate/data/katepart.desktop:2
msgctxt "Name"
msgid "Embedded Advanced Text Editor"
msgstr "Integrowany lěpši wobdźěłar teksta"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:16
msgctxt "Name"
msgid "Autobookmarker"
msgstr "Awtobookmarker"

#: kate/plugins/autobookmarker/ktexteditor_autobookmarker.desktop:87
msgctxt "Comment"
msgid "Set bookmarks on lines matching a pattern when documents are loaded"
msgstr ""
"Staja při začitanju dokumenta znamjenja na linki, kiž wěstemu mustrej "
"wotpowěduja."

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:17
msgctxt "Name"
msgid "Insert File"
msgstr "Dokument zasunyć"

#: kate/plugins/insertfile/ktexteditor_insertfile.desktop:96
msgctxt "Comment"
msgid "Insert any readable file at cursor position"
msgstr "Zasunje lubowólnu čitajomnu dataju na poziciji cursora"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:17
msgctxt "Name"
msgid "Data Tools"
msgstr "Datowe nastroje"

#: kate/plugins/kdatatool/ktexteditor_kdatatool.desktop:86
msgctxt "Comment"
msgid "Enable data tools like thesaurus and spell check (if installed)"
msgstr ""
"Staja graty kaž tezawrus abo prawopisnu kontrolu k dispoziciji (jeli "
"instalowane)"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:5
msgctxt "Name"
msgid "Python encoding checker/adder"
msgstr "Python encoding checker/adder"

#: kate/plugins/pythonencoding/ktexteditor_python-encoding.desktop:59
msgctxt "Comment"
msgid "While saving check encoding of python files and add an encoding line"
msgstr ""
"Přepruwuje koděrowanje python-datajow a doda linku z informaciju wo "
"koděrowanju"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:18
msgctxt "Name"
msgid "Time & Date"
msgstr "Čas a datum"

#: kate/plugins/timedate/ktexteditor_timedate.desktop:94
msgctxt "Comment"
msgid "Insert current Time & Date"
msgstr "Zasunje aktualny čas a datum"

#: kate/plugins/timedate/ktexteditor_timedate_config.desktop:7
msgctxt "Name"
msgid "Format of Time & Date insertion"
msgstr "Format časa a datuma, kiž so zasunjetej"

