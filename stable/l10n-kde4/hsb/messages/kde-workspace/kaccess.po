#: kaccess.cpp:694
#, kde-format
msgid "Do you really want to deactivate \"%1\"?"
msgstr "Chceće woprawdźe \"%1\" wupinać?"

#: kaccess.cpp:697
#, kde-format
msgid "Do you really want to deactivate \"%1\" and \"%2\"?"
msgstr "Chceće woprawdźe \"%1\" a \"%2\" wupinać?"

