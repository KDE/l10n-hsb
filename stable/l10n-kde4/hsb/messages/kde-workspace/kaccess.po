#: kaccess.cpp:711
#, kde-format
msgid "Do you really want to activate \"%1\"?"
msgstr "Chceće woprawdźe \"%1\" zaswěćić?"

#: kaccess.cpp:714
#, kde-format
msgid "Do you really want to activate \"%1\" and to deactivate \"%2\"?"
msgstr "Chceće woprawdźe \"%1\" zaswěćić a \"%2\" wupinać?"

#: kaccess.cpp:717
#, kde-format
msgid ""
"Do you really want to activate \"%1\" and to deactivate \"%2\" and \"%3\"?"
