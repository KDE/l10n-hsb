msgstr "Chceće woprawdźe \"%1\" zaswěćić a \"%2\", \"%3\" a \"%4\" wupinać?"

#: kaccess.cpp:728
#, kde-format
msgid "Do you really want to activate \"%1\" and \"%2\"?"
