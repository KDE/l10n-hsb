#: kaccess.cpp:735
#, kde-format
msgid ""
"Do you really want to activate \"%1\", and \"%2\" and to deactivate \"%3\" "
"and \"%4\"?"
msgstr "Chceće woprawdźe \"%1\" a \"%2\" zaswěćić a \"%3\" a \"%4\" wupinać?"

