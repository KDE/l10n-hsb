#: random.cpp:48
#, kde-format
msgid ""
"Usage: %1 [-setup] [args]\n"
"Starts a random screen saver.\n"
"Any arguments (except -setup) are passed on to the screen saver."
msgstr ""
"Wužiwanje: %1 [-setup] [argumenty]\n"
"Startuje připadnje někajki škitar wobrazowki.\n"
"Wšitke argumenty (nimo -setup) do škitarjej dale dawaja."

#: random.cpp:55
#, kde-format
msgid "Start a random KDE screen saver"
msgstr "Startuj připadnje někajki KDE-škitar wobrazowki"

