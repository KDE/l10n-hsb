#: smartcard.cpp:395
#, kde-format
msgid ""
"<h1>smartcard</h1> This module allows you to configure KDE support for "
"smartcards. These can be used for various tasks such as storing SSL "
"certificates and logging in to the system."
msgstr ""
"<h1>smartcard</h1> Tutón modul Wam dowoli KDE za smartcards připrawić. "
"Smartcards hodźa so za wjele wěcow wužiwać kaž składowanje SSL-certifikatow "
"a přizjewjenje."

#. i18n: ectx: attribute (title), widget (QWidget)
#: smartcardbase.ui:31
#, kde-format
msgid "Smartcard Support"
msgstr "Podpěra za smartcards"

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:42
#, kde-format
msgid "&Enable smartcard support"
msgstr "Podpěru za smartcards k dispoziciji stajić"

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:61
#, kde-format
msgid "Enable &polling to autodetect card events"
msgstr "&Polling wužiwać za awtomatiske zwěsćenje smartcardow"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#: smartcardbase.ui:64
#, kde-format
msgid ""
"In most cases you should have this enabled. It allows KDE to automatically "
"detect card insertion and reader hotplug events."
msgstr ""
"Normalnje měło to być zaswěćene. Dowoli KDE, awtomatisce zwěsćić, hač je so "
"karta zasunyła."

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:92
#, kde-format
msgid "Automatically &launch card manager if inserted card is unclaimed"
msgstr ""
"Awtomatisce &kartowy rjadowar startować, hdyž zasunjenu kartu hewak nichtó "
"njecha"

#. i18n: ectx: property (whatsThis), widget (QCheckBox)
#: smartcardbase.ui:95
#, kde-format
msgid ""
"When you insert a smartcard, KDE can automatically launch a management tool "
"if no other application attempts to use the card."
msgstr ""
"Hdyž smartcard zasunjeće, móže KDE awtomatisce administratiwny program "
"startować, hdyž žana druha aplikacija njespyta kartu wužiwać."

#. i18n: ectx: property (text), widget (QCheckBox)
#: smartcardbase.ui:106
#, kde-format
msgid "&Beep on card insert and removal"
msgstr "&Piwčeć, hdyž so karta zasunje abo wućehnje"

